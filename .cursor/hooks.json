{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/config-universal/hooks/serena-remind.sh"
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/config-universal/hooks/block-gh-cli.sh",
        "matcher": "(^|[;&|] *)gh (api|pr|issue|run|release)($|[ ;&|])"
      },
      {
        "command": ".cursor/config-universal/hooks/block-git-write.sh",
        "matcher": "(^|[;&|] *)git (add|commit|push|reset|switch|restore|checkout)($|[ ;&|-])"
      },
      {
        "command": ".cursor/config-universal/hooks/block-git-write.sh",
        "matcher": "(^|[;&|] *)git stash($|[;&|]| +(push|pop|drop|apply|clear|save|-[upak]|--[a-z])| +-)"
      },
      {
        "command": ".cursor/config-universal/hooks/block-git-write.sh",
        "matcher": "(^|[;&|] *)git branch +-[dD]($|[ ;&|])"
      },
      {
        "command": ".cursor/config-universal/hooks/block-mongo.sh",
        "matcher": "(^|[;&|] *)(mongosh|mongo)($|[ ;&|])"
      },
      {
        "command": ".cursor/config-universal/hooks/block-sudo.sh",
        "matcher": "(^|[;&|] *)sudo "
      },
      {
        "command": ".cursor/config-universal/hooks/block-kill.sh",
        "matcher": "(^|[;&|] *)(kill|killall) "
      },
      {
        "command": ".cursor/config-universal/hooks/block-kill.sh",
        "matcher": "(^|[;&|] *)pkill +(?!-f\\b)"
      },
      {
        "command": ".cursor/config-universal/hooks/block-publish.sh",
        "matcher": "(^|[;&|] *)(npm publish|yarn publish)($|[ ;&|])"
      },
      {
        "command": ".cursor/config-universal/hooks/block-dangerous.sh",
        "matcher": "(^|[;&|] *)(dd if=|shutdown|reboot)"
      },
      {
        "command": ".cursor/config-universal/hooks/block-extension-overwrite.sh",
        "matcher": "(^|[;&|] *)(cp |cp -|rsync |mv )[^|;]*local\\.dc"
      },
      {
        "command": ".cursor/config-universal/hooks/block-recursive-delete.sh",
        "matcher": "(^|[;&|] *)rm +((-[a-zA-Z]*[rR])|--recursive)"
      }
    ]
  },
