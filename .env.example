# Client ID de tu aplicación OAuth de YNAB (Account Settings > Developer Settings).
# Solo se usa el Client ID (flujo Implicit Grant); el Client Secret NO se usa ni debe
# incluirse en el cliente.
VITE_YNAB_CLIENT_ID=tu_client_id_de_ynab

# Redirect URI(s) a registrar en la app OAuth de YNAB (uno por línea en YNAB).
# Deben coincidir EXACTAMENTE (incluida la barra final) con donde corre la app:
#   Producción:  https://joshnavdev.github.io/mortgage-simulator/
#   Local (Vite): http://localhost:5173/mortgage-simulator/
