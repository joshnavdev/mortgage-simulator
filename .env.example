# Client ID de tu aplicación OAuth de YNAB (Account Settings > Developer Settings).
# Se usa para el flujo Authorization Code: el cliente redirige a YNAB con este Client ID
# y YNAB regresa con un ?code=... El Client Secret NO se usa ni debe incluirse en el cliente.
VITE_YNAB_CLIENT_ID=tu_client_id_de_ynab

# Redirect URI registrada en la app OAuth de YNAB. Debe coincidir BYTE-A-BYTE en tres lugares:
#   1. El campo Redirect URI de tu app OAuth de YNAB.
#   2. La variable YNAB_REDIRECT_URI del backend (parámetro del stack).
#   3. Este valor (el cliente lo envía al construir la URL de authorize).
# Es la página del cliente que captura el ?code=, p. ej.:
#   Producción:  https://joshnavdev.github.io/mortgage-simulator/
#   Local (Vite): http://localhost:5173/mortgage-simulator/
VITE_YNAB_REDIRECT_URI=https://joshnavdev.github.io/mortgage-simulator/

# Cognito: App Client ID público (sin client secret) del User Pool.
VITE_COGNITO_CLIENT_ID=tu_cognito_client_id

# Región AWS del User Pool de Cognito.
VITE_COGNITO_REGION=us-east-1

# Base URL del API backend que intercambia el código de YNAB y guarda los tokens.
VITE_API_BASE_URL=https://api.ynabagent.josnavdev.lat
